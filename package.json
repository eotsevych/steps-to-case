  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --config ./vite.config.ts & vite build --watch --config ./vite.content.config.ts",
    "build": "vite build --config ./vite.config.ts && vite build --config ./vite.content.config.ts && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/chrome": "^0.0.268",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.5.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
